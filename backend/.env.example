# Copiar a .env para desarrollo local (nunca commitear .env real).
# En producción estas mismas claves se cargan desde el panel del servicio
# en Render (Environment) -- panel del servicio en dashboard.render.com.

SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_TOKEN_PATH=schwab_token.json

SUPABASE_URL=
SUPABASE_KEY=

FIREBASE_DB_URL=

GROQ_API_KEY=

# Open Interest real de NDX/VIX (Schwab no lo da para indices) -- cuenta
# gratis sin tarjeta en marketdata.app
MARKETDATA_API_KEY=

# Calendario economico (CPI/FOMC/NFP) para el prompt de la IA -- opcional,
# cuenta gratis sin tarjeta en finnhub.io
FINNHUB_API_KEY=

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=20

ENVIRONMENT=development
