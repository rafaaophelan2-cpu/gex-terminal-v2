# Copiar a .env para desarrollo local (nunca commitear .env real).
# En producción estas mismas claves se cargan desde el panel del servicio
# en Render (Environment) -- panel del servicio en dashboard.render.com.

SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_TOKEN_PATH=schwab_token.json

SUPABASE_URL=
SUPABASE_KEY=

FIREBASE_DB_URL=

GROQ_API_KEY=

# Open Interest real de NDX/VIX (Schwab no lo da para indices) -- cuenta
# gratis sin tarjeta en marketdata.app
MARKETDATA_API_KEY=

# Feed de noticias de mercado para la pestana News -- opcional, cuenta
# gratis sin tarjeta en finnhub.io. El calendario economico (CPI/FOMC/NFP)
# NO usa esta key -- integrations/forexfactory_client.py es un feed
# publico sin autenticacion (el endpoint de calendario de Finnhub
# devuelve 403 en el tier gratis, confirmado en vivo).
FINNHUB_API_KEY=

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=20

ENVIRONMENT=development
