# Copiar a .env para desarrollo local (nunca commitear .env real).
# En producción estas mismas claves se cargan desde Hugging Face Spaces:
# Settings del Space -> "Variables and secrets" -> agregar cada una ahí
# (no hay CLI; es una tabla en la UI del Space).

SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_TOKEN_PATH=schwab_token.json

SUPABASE_URL=
SUPABASE_KEY=

FIREBASE_DB_URL=

GROQ_API_KEY=
GEMINI_API_KEY=

JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=20

ENVIRONMENT=development
