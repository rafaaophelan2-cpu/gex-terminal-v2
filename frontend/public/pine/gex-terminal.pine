//@version=5
// "Gex Terminal" -- Gamma Levels para TradingView
// Único input de niveles: el string que genera gex-terminal-8vb.pages.dev
// (Tools > Strings), actualizado cada 1 minuto durante el horario de
// mercado. Del conversor ETF<->Futuros original solo queda la MATEMÁTICA
// de conversión (ratio suavizado) -- el resto (colores, grosor, estilo)
// es una opción independiente POR NIVEL, para que los 8 niveles sean
// distinguibles a simple vista.
indicator("Gex Terminal", overlay = true, max_lines_count = 500, max_labels_count = 500)

// --- 1. CONVERSION ENGINE --------------------------------------------
grp_conv = "Conversion Engine"
etf_symbol = input.symbol("NASDAQ:QQQ", "ETF / Index Symbol", group=grp_conv, tooltip="Símbolo del ETF/índice de opciones contra el que se calcula el ratio de conversión en vivo -- por defecto QQQ, que es lo que usa gex-terminal-8vb.pages.dev para NQ/MNQ. El indicador asume que lo tenés puesto sobre el chart del FUTURO (NQ/MNQ), no del ETF.")
input_smoothing = input.int(100, "Level Smoothing", minval=1, maxval=600, group=grp_conv, tooltip="Promedia el ratio de precio sobre esta cantidad de barras -- evita que los niveles salten con micro-volatilidad. Más preciso en timeframes bajos (1-5 min).")
tick_size = input.float(0, "Tick Size Rounding", minval=0, group=grp_conv, tooltip="Redondea el nivel convertido al tick size más cercano (ej. 0.25 para NQ/MNQ). Dejar en 0 para el cálculo exacto.")

grp_string = "GEX Terminal String"
gex_string_input = input.text_area("$QQQ!: Call Wall 1, 720, Call Wall 2, 725, Call Wall 3, 730, Put Wall 1, 718, Put Wall 2, 710, Put Wall 3, 715, Gamma Flip, 709, Gamma Wall, 705.", "String de GEX Terminal", group=grp_string, tooltip="Pegá acá el string que genera gex-terminal-8vb.pages.dev en Tools > Strings -- se actualiza cada 1 minuto durante la Cash Session (08:31-15:00 hora Lima).")

// --- 2. ESTILO POR NIVEL (color / grosor / estilo de línea) ----------
// Orden fijo -- el mismo en que domain/tradingview_string.py arma el
// string SIEMPRE: CW1, CW2, CW3, PW1, PW2, PW3, Gamma Flip, Gamma Wall.
// Colores por defecto: verde para calls / rojo para puts, más intenso
// cuanto más importante el nivel (1 el más fuerte, 3 el más débil);
// Gamma Flip en azul (mismo acento que "Zero Gamma" en la web); Gamma
// Wall en naranja, para que resalte como el nivel de mayor actividad
// bruta de gamma de toda la cadena.
grp_cw1 = "Call Wall 1"
cw1_color = input.color(#00FF88, "Color / Ancho / Estilo", group=grp_cw1, inline="cw1")
cw1_width = input.int(3, "", minval=1, maxval=6, group=grp_cw1, inline="cw1")
cw1_style = input.string("Solid", "", options=["Solid", "Dashed", "Dotted"], group=grp_cw1, inline="cw1")

grp_cw2 = "Call Wall 2"
cw2_color = input.color(#00B368, "Color / Ancho / Estilo", group=grp_cw2, inline="cw2")
cw2_width = input.int(2, "", minval=1, maxval=6, group=grp_cw2, inline="cw2")
cw2_style = input.string("Solid", "", options=["Solid", "Dashed", "Dotted"], group=grp_cw2, inline="cw2")

grp_cw3 = "Call Wall 3"
cw3_color = input.color(#007A47, "Color / Ancho / Estilo", group=grp_cw3, inline="cw3")
cw3_width = input.int(1, "", minval=1, maxval=6, group=grp_cw3, inline="cw3")
cw3_style = input.string("Dashed", "", options=["Solid", "Dashed", "Dotted"], group=grp_cw3, inline="cw3")

grp_pw1 = "Put Wall 1"
pw1_color = input.color(#FF3B30, "Color / Ancho / Estilo", group=grp_pw1, inline="pw1")
pw1_width = input.int(3, "", minval=1, maxval=6, group=grp_pw1, inline="pw1")
pw1_style = input.string("Solid", "", options=["Solid", "Dashed", "Dotted"], group=grp_pw1, inline="pw1")

grp_pw2 = "Put Wall 2"
pw2_color = input.color(#CC2E26, "Color / Ancho / Estilo", group=grp_pw2, inline="pw2")
pw2_width = input.int(2, "", minval=1, maxval=6, group=grp_pw2, inline="pw2")
pw2_style = input.string("Solid", "", options=["Solid", "Dashed", "Dotted"], group=grp_pw2, inline="pw2")

grp_pw3 = "Put Wall 3"
pw3_color = input.color(#99221C, "Color / Ancho / Estilo", group=grp_pw3, inline="pw3")
pw3_width = input.int(1, "", minval=1, maxval=6, group=grp_pw3, inline="pw3")
pw3_style = input.string("Dashed", "", options=["Solid", "Dashed", "Dotted"], group=grp_pw3, inline="pw3")

grp_flip = "Gamma Flip"
flip_color = input.color(#3B82F6, "Color / Ancho / Estilo", group=grp_flip, inline="flip")
flip_width = input.int(2, "", minval=1, maxval=6, group=grp_flip, inline="flip")
flip_style = input.string("Dashed", "", options=["Solid", "Dashed", "Dotted"], group=grp_flip, inline="flip")

grp_wall = "Gamma Wall"
wall_color = input.color(#FF9500, "Color / Ancho / Estilo", group=grp_wall, inline="wall")
wall_width = input.int(3, "", minval=1, maxval=6, group=grp_wall, inline="wall")
wall_style = input.string("Solid", "", options=["Solid", "Dashed", "Dotted"], group=grp_wall, inline="wall")

grp_overlap = "Niveles Superpuestos"
overlap_color = input.color(#FFEB3B, "Color de línea superpuesta", group=grp_overlap, tooltip="Cuando 2 o más niveles caen en el mismo precio convertido (ej. Call Wall 1 y Gamma Wall), se dibuja UNA sola línea con ambos nombres juntos ('Call Wall 1 / Gamma Wall') en vez de dos líneas pisándose -- siempre con este color, para que sea obvio a simple vista que ahí hay más de un nivel confluyendo.")

// --- 3. CONVERSIÓN EN VIVO --------------------------------------------
// Cuánto para atrás arranca cada línea -- a diferencia del script
// original (que escaneaba hasta 1000 barras buscando la mitigación
// histórica exacta), acá se simplificó a una ventana fija: los niveles
// de GEX son de HOY, no hace falta reconstruir su historial de toques.
LOOKBACK_BARS = 80
LABEL_OFFSET_BARS = 15

sym_etf_ext = ticker.modify(etf_symbol, session.extended)
ETFClose = request.security(sym_etf_ext, timeframe.period, close, barmerge.gaps_on)
CurClose = close
Diff = CurClose / ETFClose
smoothed_diff = ta.sma(Diff, input_smoothing)

// time[math.min(bar_index, LOOKBACK_BARS)] más abajo usa un índice
// dinámico (variable, no una constante literal) -- Pine no siempre
// infiere solo cuánta historia hace falta guardar en ese caso, así que
// se lo dice explícito acá.
max_bars_back(time, LOOKBACK_BARS)

round_tick(val, tick) => tick == 0 ? val : math.round(val / tick) * tick

get_line_style(s) =>
    switch s
        "Dashed" => line.style_dashed
        "Dotted" => line.style_dotted
        => line.style_solid

// Parsea "$TICKER!: Nombre, valor, Nombre, valor, ..., Nombre, valor." --
// el formato exacto que genera domain/tradingview_string.py. Pares
// estrictamente alternados (nombre, valor) después de los ":"; un par
// cuyo segundo token no sea un número válido se descarta en silencio.
parse_gex_string(str_in) =>
    float[] vals = array.new_float()
    string[] cmts = array.new_string()
    string body = str_in
    int colon_idx = str.pos(str_in, ":")
    if colon_idx >= 0
        body := str.substring(str_in, colon_idx + 1)
    string[] tokens = str.split(body, ",")
    int n = array.size(tokens)
    int pair_count = n / 2
    if pair_count > 0
        for i = 0 to pair_count - 1
            string name_part = str.trim(array.get(tokens, i * 2))
            string val_part = str.trim(array.get(tokens, i * 2 + 1))
            // El ÚLTIMO valor viene con el punto final de la oración
            // pegado (".705." -> token "705."), NO un separador decimal
            // -- se recorta solo si es el último carácter, para no tocar
            // el punto decimal real de otros valores (717.5, 709.25...).
            if str.endswith(val_part, ".")
                val_part := str.substring(val_part, 0, str.length(val_part) - 1)
            float v = str.tonumber(val_part)
            if not na(v) and name_part != ""
                array.push(cmts, name_part)
                array.push(vals, v)
    [vals, cmts]

// --- 4. DIBUJO (una vez por barra, solo la última) --------------------
var line[] level_lines = array.new_line()
var label[] level_labels = array.new_label()

var color[] level_colors = array.from(cw1_color, cw2_color, cw3_color, pw1_color, pw2_color, pw3_color, flip_color, wall_color)
var int[] level_widths = array.from(cw1_width, cw2_width, cw3_width, pw1_width, pw2_width, pw3_width, flip_width, wall_width)
var string[] level_styles = array.from(cw1_style, cw2_style, cw3_style, pw1_style, pw2_style, pw3_style, flip_style, wall_style)

if barstate.islast
    if array.size(level_lines) > 0
        for i = 0 to array.size(level_lines) - 1
            line.delete(array.get(level_lines, i))
    array.clear(level_lines)

    if array.size(level_labels) > 0
        for i = 0 to array.size(level_labels) - 1
            label.delete(array.get(level_labels, i))
    array.clear(level_labels)

    [gen_strikes, gen_comments] = parse_gex_string(gex_string_input)

    int n_levels = math.min(array.size(gen_strikes), array.size(gen_comments))

    if n_levels > 0 and not na(smoothed_diff)
        int start_time = time[math.min(bar_index, LOOKBACK_BARS)]
        int time_offset_ms = (time - time[1]) * LABEL_OFFSET_BARS
        int right_x_time = time + time_offset_ms

        // vals_out y consumed se arman en el MISMO loop, elemento por
        // elemento -- así quedan garantizados del mismo tamaño (n_levels)
        // pase lo que pase, en vez de confiar en dos construcciones
        // separadas que podrían desincronizarse. Cada array.get() de acá
        // en más además revalida su índice contra array.size() real en
        // el momento, no solo contra n_levels, para que un eventual
        // desajuste se salte en silencio en vez de tirar un runtime error.
        float[] vals_out = array.new_float()
        bool[] consumed = array.new_bool()
        for i = 0 to n_levels - 1
            array.push(vals_out, round_tick(array.get(gen_strikes, i) * smoothed_diff, tick_size))
            array.push(consumed, false)

        // Cuando 2+ niveles caen en el MISMO precio convertido (ej. Call
        // Wall 1 y Gamma Wall), se dibuja UNA sola línea con ambos
        // nombres juntos ("Call Wall 1 / Gamma Wall") en vez de dos
        // líneas pisándose -- siempre en overlap_color, con el ancho más
        // grueso de los niveles que se fusionaron (para que se note que
        // ahí hay más de un nivel, no solo el más angosto de los dos).
        //
        // OJO: acá abajo cada chequeo de rango vive en su PROPIO 'if'
        // anidado, nunca combinado con 'and' ni con el operador ternario
        // '?:' -- en Pine NINGUNO de los dos hace cortocircuito (evalúan
        // TODAS las ramas/operandos siempre, sin importar el primer
        // resultado), así que "i < array.size(x) and array.get(x, i)"
        // llama a array.get() igual aunque el índice esté fuera de rango
        // -- eso fue justo lo que seguía rompiendo el indicador después
        // del primer intento de arreglo.
        for i = 0 to n_levels - 1
            bool i_in_range = i < array.size(consumed)
            bool i_free = false
            if i_in_range
                if not array.get(consumed, i)
                    i_free := true

            if i_in_range
                if i_free
                    array.set(consumed, i, true)
                    float val_out_i = array.get(vals_out, i)
                    float val_in_i = array.get(gen_strikes, i)

                    string combined_label = ""
                    if i < array.size(gen_comments)
                        combined_label := array.get(gen_comments, i)

                    color lvl_color = color.gray
                    if i < array.size(level_colors)
                        lvl_color := array.get(level_colors, i)

                    int lvl_width = 2
                    if i < array.size(level_widths)
                        lvl_width := array.get(level_widths, i)

                    string lvl_style = "Solid"
                    if i < array.size(level_styles)
                        lvl_style := array.get(level_styles, i)

                    bool is_overlap = false

                    for j = i + 1 to n_levels - 1
                        bool j_in_range = j < array.size(consumed)
                        if j_in_range
                            j_in_range := j < array.size(vals_out)

                        bool j_free = false
                        if j_in_range
                            if not array.get(consumed, j)
                                j_free := true

                        bool j_matches = false
                        if j_free
                            if array.get(vals_out, j) == val_out_i
                                j_matches := true

                        if j_matches
                            if j < array.size(gen_comments)
                                combined_label := combined_label + " / " + array.get(gen_comments, j)
                            array.set(consumed, j, true)
                            is_overlap := true
                            int j_width = 2
                            if j < array.size(level_widths)
                                j_width := array.get(level_widths, j)
                            if j_width > lvl_width
                                lvl_width := j_width

                    if is_overlap
                        lvl_color := overlap_color
                        lvl_style := "Solid"

                    line l = line.new(start_time, val_out_i, right_x_time, val_out_i, xloc=xloc.bar_time, color=lvl_color, width=lvl_width, style=get_line_style(lvl_style), extend=extend.right)
                    array.push(level_lines, l)

                    string label_txt = combined_label + "\n" + str.tostring(val_out_i, "#.##") + " (" + str.tostring(val_in_i, "#.##") + ")"
                    label lb = label.new(right_x_time, val_out_i, text=label_txt, xloc=xloc.bar_time, style=label.style_label_left, color=color.new(color.black, 100), textcolor=lvl_color, size=size.small, text_font_family=font.family_monospace)
                    array.push(level_labels, lb)
